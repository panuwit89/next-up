# ==== Anime (Discord) bot ====
DISCORD_TOKEN=your_discord_bot_token_here
MONGO_URI=your_mongodb_connection_string_here

# Only needed to subscribe from the web dashboard while ZERO subscriptions
# exist. Normally the target is copied from an existing subscription.
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_ID=

# ==== Finance (LINE) bot ====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ==== LLM ====
# openai (default) or gemini. Only the chosen provider's key is needed.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# gpt-6-luna is plenty for one-line notes; gpt-6.1-sol costs ~20x more.
OPENAI_MODEL=gpt-6-luna
# luna: none|low|medium|high|xhigh|max — sol starts at low.
OPENAI_REASONING_EFFORT=low
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# ==== News ====
NEWSAPI_KEY=

# ==== Stock prices ====
# Yahoo's chart endpoint is tried first and needs no key, but it rate-limits by
# IP and rejects Render's shared egress addresses (HTTP 429). This free key from
# twelvedata.com is the fallback and is REQUIRED in production.
TWELVEDATA_API_KEY=

# ==== Weekly schedule (24h format, Asia/Bangkok) ====
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Bangkok

# ==== Finance source configuration ====
# STOCK_SYMBOLS only SEEDS the watchlist the first time the app runs against an
# empty database. After that MongoDB is the source of truth and this value is
# ignored — add/remove symbols through the dashboard API instead.
STOCK_SYMBOLS=tsmc,nvidia
NEWS_QUERY=technology OR finance OR stocks OR AI

# Public dashboard URL for the "ดูกราฟ" buttons on the LINE cards (https only).
# Leave empty on Render: RENDER_EXTERNAL_URL is used automatically.
DASHBOARD_URL=
